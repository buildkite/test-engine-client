#!/usr/bin/env bash
set -euo pipefail

step() {
  printf '\n--- %s\n' "$1"
  SECONDS=0
}

done_step() {
  printf '%s completed in %ss\n' "$1" "$SECONDS"
}

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step "Installing mise and pinned toolchains"
if [[ ! -x "$HOME/.local/bin/mise" ]]; then
  curl -fsSL https://mise.run | sh
fi
export PATH="$HOME/.local/bin:$PATH"
eval "$(mise activate bash)"
mise trust --yes "$repo_root/.tool-versions"
mise install
done_step "Toolchains"

step "Configuring login shells"
profile_marker="# test-engine-client development environment"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
eval "\$("$HOME/.local/bin/mise" activate bash)"
if [[ "\${PWD}" == "$repo_root" ]]; then
  export PATH="$repo_root/.venv/bin:\$PATH"
fi
EOF
fi
done_step "Login shell configuration"

step "Downloading Go dependencies and tools"
go mod download
GOBIN="$HOME/.local/bin" go install gotest.tools/gotestsum@v1.8.0
done_step "Go dependencies"

step "Installing Bats"
if [[ "$(bats --version 2>/dev/null || true)" != "Bats 1.14.0" ]]; then
  bats_source="$(mktemp -d)"
  trap 'rm -rf "$bats_source"' EXIT
  git clone --quiet --depth 1 --branch v1.14.0 https://github.com/bats-core/bats-core.git "$bats_source"
  "$bats_source/install.sh" "$HOME/.local"
  rm -rf "$bats_source"
  trap - EXIT
fi
done_step "Bats"

step "Installing JavaScript dependencies"
if ! command -v yarn >/dev/null 2>&1; then
  npm install --global yarn@1.22.22
fi
yarn --cwd internal/runner/testdata install --frozen-lockfile
done_step "JavaScript dependencies"

step "Installing Playwright browsers"
(
  cd internal/runner/testdata/playwright
  yarn playwright install --with-deps chromium firefox
)
done_step "Playwright browsers"

step "Installing Cypress"
(
  cd internal/runner/testdata/cypress
  yarn cypress install
  yarn cypress verify
)
done_step "Cypress"

step "Installing Ruby dependencies"
bundle install --gemfile internal/runner/testdata/rspec/Gemfile
bundle install --gemfile internal/runner/testdata/cucumber/Gemfile
done_step "Ruby dependencies"

step "Installing Python dependencies"
uv venv --python 3.13.2 --allow-existing .venv
uv pip install --python .venv/bin/python pytest 'buildkite-test-collector>=1.3.0'
done_step "Python dependencies"
