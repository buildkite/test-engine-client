{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug rspec run",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceRoot}",
      "args": ["run"],
      "cwd": "${workspaceFolder}/internal/runner/testdata/rspec",
      "envFile": "${workspaceFolder}/.vscode/.env",
      "env": {
        "BUILDKITE_TEST_ENGINE_TEST_RUNNER": "rspec",
        "BUILDKITE_TEST_ENGINE_RESULT_PATH": "tmp/result.json",
        "BUILDKITE_TEST_ENGINE_TEST_FILE_EXCLUDE_PATTERN": "spec/{exit}_spec.rb",
        "BUILDKITE_STEP_ID": "rspec",
        "BUILDKITE_BUILD_ID": "${input:build-id}"
      }
    },
    {
      "name": "Debug jest run",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceRoot}",
      "args": ["run"],
      "cwd": "${workspaceFolder}/internal/runner/testdata/jest",
      "envFile": "${workspaceFolder}/.vscode/.env",
      "env": {
        "BUILDKITE_TEST_ENGINE_TEST_RUNNER": "jest",
        "BUILDKITE_TEST_ENGINE_RESULT_PATH": "tmp/result.json",
        "BUILDKITE_STEP_ID": "jest",
        "BUILDKITE_BUILD_ID": "${input:build-id}"
      }
    },
    {
      "name": "Debug gotest run",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceRoot}",
      "args": ["run"],
      "cwd": "${workspaceFolder}/internal/runner/testdata/go",
      "envFile": "${workspaceFolder}/.vscode/.env",
      "env": {
        "BUILDKITE_TEST_ENGINE_TEST_RUNNER": "gotest",
        "BUILDKITE_TEST_ENGINE_RESULT_PATH": "tmp/result.junit",
        "BUILDKITE_TEST_ENGINE_SELECTOR_SPLITTING": "true",
        "BUILDKITE_STEP_ID": "gotest",
        "BUILDKITE_BUILD_ID": "${input:build-id}"
      }
    },
    {
      "name": "Debug pytest run",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceRoot}",
      "args": ["run"],
      "cwd": "${workspaceFolder}/internal/runner/testdata/pytest",
      "envFile": "${workspaceFolder}/.vscode/.env",
      "env": {
        "BUILDKITE_TEST_ENGINE_TEST_RUNNER": "pytest",
        "BUILDKITE_STEP_ID": "pytest",
        "BUILDKITE_BUILD_ID": "${input:build-id}"
      }
    },
    {
      "name": "Debug playwright run",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceRoot}",
      "args": ["run"],
      "cwd": "${workspaceFolder}/internal/runner/testdata/playwright",
      "envFile": "${workspaceFolder}/.vscode/.env",
      "env": {
        "BUILDKITE_TEST_ENGINE_TEST_RUNNER": "playwright",
        "BUILDKITE_TEST_ENGINE_RESULT_PATH": "tmp/result.json",
        "BUILDKITE_STEP_ID": "playwright",
        "BUILDKITE_BUILD_ID": "${input:build-id}"
      }
    },
    {
      "name": "Debug custom run",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceRoot}",
      "args": ["run"],
      "cwd": "${workspaceFolder}/internal/runner/testdata/custom",
      "envFile": "${workspaceFolder}/.vscode/.env",
      "env": {
        "BUILDKITE_TEST_ENGINE_TEST_RUNNER": "custom",
        "BUILDKITE_TEST_ENGINE_TEST_CMD": "bats --report-formatter junit --output tmp/ . {{testExamples}}",
        "BUILDKITE_TEST_ENGINE_TEST_FILE_PATTERN": "tests/*.bats",
        "BUILDKITE_TEST_ENGINE_RESULT_PATH": "tmp/report.xml",
        "BUILDKITE_STEP_ID": "custom",
        "BUILDKITE_BUILD_ID": "${input:build-id}"
      }
    }
  ],
  "inputs": [
    {
      "id": "build-id",
      "type": "promptString",
      "description": "Enter a unique identifier for this run"
    }
  ]
}
